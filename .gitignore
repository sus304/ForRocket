# Ignore tests/ contents by default, but version-control the C++ unit tests.
# (The E2E suite tests/simulation_test.py is intentionally left untracked for
# now — see CI notes — pending baseline analysis.)
# Use tests/* (not tests/) so tests/unit/ can be re-included: git cannot
# re-include a path whose parent dir is itself ignored.
tests/*
!tests/unit/

# Simulation output CSVs in examples/
examples/*_flight_log.csv
examples/debug_*.csv
examples/test_*.csv

